# Free API key: https://console.groq.com/keys
GROQ_API_KEY=

# Any chat model listed at https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# Personality of your bot
SYSTEM_PROMPT=You are a friendly assistant. Reply in simple Hinglish (Hindi written in English letters) unless the user writes in English.

# Max requests per IP per minute
RATE_LIMIT_PER_MINUTE=20
